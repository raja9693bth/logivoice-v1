# =========================================================================
# LOGIVOICE V1 — AUTHORITATIVE ENVIRONMENT CONFIGURATION CONTRACT
#
# Variable Classifications:
# - [REQUIRED PRODUCTION]: Mandatory for production boot & operation
# - [OPTIONAL]: Discretionary operational overrides
# - [CONFIGURATION-GATED]: Activates integrated external subsystems when provided
# - [TEST-ONLY]: Isolated to local testing and development pipelines
# - [PUBLIC/CLIENT-SAFE]: Exposed to client browser via NEXT_PUBLIC_ prefix
# =========================================================================

# -------------------------------------------------------------------------
# APPLICATION & RUNTIME
# -------------------------------------------------------------------------
# [REQUIRED PRODUCTION] Execution environment
NODE_ENV=development
# [OPTIONAL] Server listen port
PORT=3000
# [PUBLIC/CLIENT-SAFE] Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [PUBLIC/CLIENT-SAFE] Demo mode flag
NEXT_PUBLIC_DEMO_MODE=false

# -------------------------------------------------------------------------
# TENANT CONFIGURATION
# -------------------------------------------------------------------------
# [REQUIRED PRODUCTION] Authoritative tenant identifier (UUID)
AUTHORITATIVE_TENANT_ID=00000000-0000-0000-0000-000000000001
# [OPTIONAL] Allow placeholder tenant in production (Defaults to false)
ALLOW_PLACEHOLDER_TENANT_IN_PROD=false

# -------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION
# -------------------------------------------------------------------------
# [REQUIRED PRODUCTION] Supabase service role key (or SUPABASE_SECRET_KEY)
SUPABASE_SECRET_KEY=
# [REQUIRED PRODUCTION] Supabase project URL
SUPABASE_URL=
# [PUBLIC/CLIENT-SAFE] [REQUIRED PRODUCTION] Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# [PUBLIC/CLIENT-SAFE] [REQUIRED PRODUCTION] Public Supabase anonymous / publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [PUBLIC/CLIENT-SAFE] [OPTIONAL] Legacy fallback alias for publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -------------------------------------------------------------------------
# DIRECT POSTGRESQL CONNECTION (Migrations & Integration Testing)
# -------------------------------------------------------------------------
# [OPTIONAL] Direct PostgreSQL connection string for CI migrations
DATABASE_URL=

# -------------------------------------------------------------------------
# SCHEDULED WORKERS & CRON
# -------------------------------------------------------------------------
# [REQUIRED PRODUCTION] Secret bearer token for /api/cron/retry-worker invocation
CRON_SECRET=

# -------------------------------------------------------------------------
# RETELL AI VOICE GATEWAY
# -------------------------------------------------------------------------
# [CONFIGURATION-GATED] Retell API secret key
RETELL_API_KEY=
# [CONFIGURATION-GATED] Retell Agent ID mapped to LogiVoice inbound flows
RETELL_AGENT_ID=
# [CONFIGURATION-GATED] Tool call signature verification secret
RETELL_TOOL_SECRET=
# [OPTIONAL] Allow legacy unsigned tool calls (Strictly false in production)
RETELL_ALLOW_LEGACY_SIGNATURE=false

# -------------------------------------------------------------------------
# TELEPHONY & LIVE CALL TRANSFER (CONFIGURATION-GATED)
# Note: Real telephone phone number / DID procurement is completed by owner.
# -------------------------------------------------------------------------
# [CONFIGURATION-GATED] Master toggle for live call transfer
ENABLE_LIVE_TELEPHONY_TRANSFER=false
# [CONFIGURATION-GATED] Twilio / Telephony Account SID (Canonical: TELEPHONY_PROVIDER_ACCOUNT_SID)
TELEPHONY_PROVIDER_ACCOUNT_SID=
# [CONFIGURATION-GATED] Twilio / Telephony Auth Token (Canonical: TELEPHONY_PROVIDER_AUTH_TOKEN)
TELEPHONY_PROVIDER_AUTH_TOKEN=
# [CONFIGURATION-GATED] Provider aliases
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# -------------------------------------------------------------------------
# META WHATSAPP BUSINESS CLOUD API (CONFIGURATION-GATED)
# -------------------------------------------------------------------------
# [CONFIGURATION-GATED] Meta Cloud API permanent system user access token
WHATSAPP_API_KEY=
# [CONFIGURATION-GATED] WhatsApp Cloud API sender phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# [CONFIGURATION-GATED] Webhook GET challenge verification token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# [CONFIGURATION-GATED] Webhook POST signature HMAC-SHA256 secret
WHATSAPP_APP_SECRET=
# [OPTIONAL] Fallback aliases
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# GOOGLE SHEETS OPERATIONAL SYNC (CONFIGURATION-GATED)
# -------------------------------------------------------------------------
# [CONFIGURATION-GATED] Target Google Spreadsheet ID
GOOGLE_SHEETS_SPREADSHEET_ID=
# [OPTIONAL] Target worksheet tab name
GOOGLE_SHEETS_WORKSHEET_NAME=LogiVoice_Calls
# [CONFIGURATION-GATED] Google Cloud OAuth Client ID
GOOGLE_CLIENT_ID=
# [CONFIGURATION-GATED] Google Cloud OAuth Client Secret
GOOGLE_CLIENT_SECRET=
# [CONFIGURATION-GATED] Google Cloud OAuth Refresh Token
GOOGLE_REFRESH_TOKEN=

# -------------------------------------------------------------------------
# DEVELOPMENT & TEST HARNESS
# -------------------------------------------------------------------------
# [TEST-ONLY] Enable deterministic in-memory mock integration adapters
ENABLE_MOCK_INTEGRATIONS=false
# [TEST-ONLY] Playwright E2E target URL
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
