# ==========================================
# LOGIVOICE V1 — AUTHORITATIVE ENVIRONMENT CONFIGURATION
# ==========================================

# -----------------------------
# APPLICATION & RUNTIME
# -----------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------
# RETELL AI VOICE GATEWAY
# -----------------------------
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_TOOL_SECRET=
RETELL_ALLOW_LEGACY_SIGNATURE=false

# -----------------------------
# TENANT CONFIGURATION (Production Fail-Closed)
# -----------------------------
AUTHORITATIVE_TENANT_ID=00000000-0000-0000-0000-000000000001

# -----------------------------
# SUPABASE (Server-side & Client-side)
# -----------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias: SUPABASE_ANON_KEY

# -----------------------------
# DATABASE & MIGRATIONS
# -----------------------------
DATABASE_URL=

# -----------------------------
# SCHEDULED WORKERS & CRON (Fail-Closed in Production)
# -----------------------------
CRON_SECRET=

# -----------------------------
# GOOGLE SHEETS OPERATIONAL SYNC (OAuth 2.0 Configuration-Gated)
# -----------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=LogiVoice_Calls
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# -----------------------------
# LIVE TELEPHONY CALL TRANSFER (SIP/PSTN Provider Confirmation)
# -----------------------------
ENABLE_LIVE_TELEPHONY_TRANSFER=false
TELEPHONY_PROVIDER_ACCOUNT_SID=
TELEPHONY_PROVIDER_AUTH_TOKEN=
# Legacy aliases: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN

# -----------------------------
# META WHATSAPP BUSINESS CLOUD API (Configuration-Gated)
# -----------------------------
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
# Legacy alias: WHATSAPP_API_TOKEN

# -----------------------------
# DEVELOPMENT & TEST MODES
# -----------------------------
ENABLE_MOCK_INTEGRATIONS=false
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
