# ==========================================
# LOGIVOICE V1 — AUTHORITATIVE ENVIRONMENT CONFIGURATION
# ==========================================

# -----------------------------
# APPLICATION & RUNTIME
# -----------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------
# RETELL AI VOICE GATEWAY
# -----------------------------
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_TOOL_SECRET=
RETELL_ALLOW_LEGACY_SIGNATURE=false

# -----------------------------
# TENANT CONFIGURATION (Production Fail-Closed)
# -----------------------------
AUTHORITATIVE_TENANT_ID=00000000-0000-0000-0000-000000000001

# -----------------------------
# SUPABASE (Server-side & Client-side)
# -----------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------
# GOOGLE SHEETS OPERATIONAL SYNC (Configuration-Gated)
# -----------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Inbound Logistics Calls
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------
# LIVE TELEPHONY CALL TRANSFER (SIP/PSTN Provider Confirmation)
# -----------------------------
ENABLE_LIVE_TELEPHONY_TRANSFER=false
TELEPHONY_PROVIDER_ACCOUNT_SID=
TELEPHONY_PROVIDER_AUTH_TOKEN=
INDIAN_TELEPHONY_SIP_URI=

# -----------------------------
# META WHATSAPP BUSINESS CLOUD API (Configuration-Gated)
# -----------------------------
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# -----------------------------
# LIVE TMS CARRIER TRACKING CONNECTOR (Configuration-Gated)
# -----------------------------
LIVE_TMS_BASE_URL=
LIVE_TMS_API_KEY=
